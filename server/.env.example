# Database dev
DATABASE_URL=postgresql://bookmark_app:your_password@localhost:5432/bookmark_app

# Database riêng cho test — bắt buộc khi chạy `yarn test`.
# Test xoá sạch mọi bảng trước mỗi case, nên phải khác DATABASE_URL.
# Tạo lần đầu: yarn db:create-test
DATABASE_URL_TEST=postgresql://bookmark_app:your_password@localhost:5432/bookmark_app_test

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Tối thiểu 32 ký tự
JWT_SECRET=

# Origin của frontend, dùng cho CORS
FRONTEND_URL=http://localhost:5173

# Giới hạn số lần gọi /auth/login và /auth/register theo IP.
# Chặt quá sẽ khoá nhầm cả văn phòng dùng chung một IP NAT.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=15 minutes
